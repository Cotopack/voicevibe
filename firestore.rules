// VoiceVibe — полный набор правил Cloud Firestore.
// Установка: Firebase Console → Firestore Database → Rules → Publish.
// Правила работают на сервере и не активируются простой загрузкой на GitHub.
// Для запросов групп используется where('members', 'array-contains', auth.uid).
// Для личных бесед используется where('participants', 'array-contains', auth.uid).
// Если документ не содержит нужного UID в соответствующем массиве,
// запрос запрещается независимо от интерфейса сайта.
// Для проверки доступа важно использовать тот же Firebase-проект,
// который настроен в опубликованном приложении.
// Версия: подробная, с комментариями; разрешения не расширены.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // ОБЩИЕ ФУНКЦИИ
    // ==============================

    function signedIn() {
      return request.auth != null;
    }

    function validReactionUpdate() {
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.reactions;
      return signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
        && after is map
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!after.keys().hasAny([request.auth.uid])
          || after[request.auth.uid] in ['❤️','👍','😂','🔥','😮','😢']);
    }

    // ==============================
    // ГОЛОСОВЫЕ СООБЩЕНИЯ (Cloudinary)
    // Только метаданные, аудиофайл хранится в Cloudinary.
    // ==============================
    function validVoiceNote() {
      let m = request.resource.data;
      return m.type == 'voice'
        && m.keys().hasOnly([
          'senderUid', 'text', 'type', 'createdAt',
          'clientMessageId', 'audioURL', 'durationSec', 'waveform', 'replyTo'
        ])
        && m.keys().hasAll([
          'senderUid', 'text', 'type', 'createdAt',
          'audioURL', 'durationSec', 'waveform'
        ])
        && m.text == ''
        && m.createdAt is int
        && m.durationSec is int
        && m.durationSec >= 1
        && m.durationSec <= 60
        && m.waveform is list
        && m.waveform.size() == 28
        && m.audioURL is string
        && m.audioURL.size() <= 2048
        && m.audioURL.matches('https://res[.]cloudinary[.]com/yvoqyrj8/video/upload/.*')
        && validReplyFields()
        && (
          !m.keys().hasAny(['clientMessageId'])
          || (
            m.clientMessageId is string
            && m.clientMessageId.size() <= 100
          )
        );
    }

    function validReplyFields() {
      let m=request.resource.data;
      return !m.keys().hasAny(['replyTo']) || (
        m.replyTo is map
        && m.replyTo.keys().hasOnly(['id','senderName','text','senderUid'])
        && m.replyTo.keys().hasAll(['id','senderName','text','senderUid'])
        && m.replyTo.id is string && m.replyTo.id.size() <= 200
        && m.replyTo.senderName is string && m.replyTo.senderName.size() <= 80
        && m.replyTo.senderUid is string && m.replyTo.senderUid.size() <= 128
        && m.replyTo.text is string && m.replyTo.text.size() <= 160
      );
    }
    function validForwardFields() {
      let m=request.resource.data;
      return !m.keys().hasAny(['forwardedFrom']) || (
        m.forwardedFrom is string && m.forwardedFrom.size() <= 80
      );
    }
    function validEdit() {
      return signedIn()
        && resource.data.senderUid == request.auth.uid
        && resource.data.type == 'text'
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1000
        && request.resource.data.editedAt is int
        && request.resource.data.editedAt >= resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt']);
    }
    function validPin() {
      let p=request.resource.data.pinnedMessage;
      return p == null || (
        p is map && p.keys().hasOnly(['id','text','senderUid'])
        && p.keys().hasAll(['id','text','senderUid'])
        && p.id is string && p.id.size() <= 200
        && p.text is string && p.text.size() <= 160
        && p.senderUid is string && p.senderUid.size() <= 128
      );
    }
    function validSelfReceipt() {
      let b=resource.data.get('readAt',{});
      let a=request.resource.data.readAt;
      return a is map && b is map
        && a.diff(b).affectedKeys().hasOnly([request.auth.uid])
        && a[request.auth.uid] is int && a[request.auth.uid] >= 0
        && a[request.auth.uid] <= request.time.toMillis() + 60000;
    }

    function validSelfDelivery() {
      let b=resource.data.get('deliveredAt',{});
      let a=request.resource.data.deliveredAt;
      return a is map && b is map
        && a.diff(b).affectedKeys().hasOnly([request.auth.uid])
        && a[request.auth.uid] is int && a[request.auth.uid] >= 0
        && a[request.auth.uid] <= request.time.toMillis() + 60000;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isModerator() {
      return signedIn() && (
        request.auth.uid == 'NL0ho7jXHmSswotGoe5H5wpA5X43'
        || (
          exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == 'NL0ho7jXHmSswotGoe5H5wpA5X43';
    }

    function storyPath(storyId) {
      return /databases/$(database)/documents/stories/$(storyId);
    }

    function mentionPath(uid, storyId) {
      return /databases/$(database)/documents/users/$(uid)/storyMentions/$(storyId);
    }

    function validStoryRepost() {
      let data = request.resource.data;

      return !data.keys().hasAny(['repostOf'])
        || (
          data.repostOf is string
          && data.repostOf.size() > 0
          && exists(storyPath(data.repostOf))
          && exists(mentionPath(request.auth.uid, data.repostOf))
          && get(storyPath(data.repostOf)).data.uid
            == data.repostAuthorUid
          && get(mentionPath(request.auth.uid, data.repostOf)).data.recipientUid
            == request.auth.uid
          && get(mentionPath(request.auth.uid, data.repostOf)).data.fromUid
            == data.repostAuthorUid
          && get(storyPath(data.repostOf)).data.expiresAt
            > request.time.toMillis()
          && data.expiresAt
            <= get(storyPath(data.repostOf)).data.expiresAt
          && data.mediaURL
            == get(storyPath(data.repostOf)).data.mediaURL
          && data.mediaType
            == get(storyPath(data.repostOf)).data.mediaType
          && data.musicURL
            == get(storyPath(data.repostOf)).data.musicURL
          && data.repostUsername is string
          && data.repostText is string
        );
    }

    // ==============================
    // АДМИНИСТРАТОРЫ
    // ==============================

    match /roles/{userId} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if signedIn();

      // ПРАВИЛО ДОСТУПА: create, update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role == 'admin';

      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if isAdmin();
    }

    // ==============================
    // ПРОФИЛИ
    // ==============================

    match /users/{userId} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if signedIn();

      // ПРАВИЛО ДОСТУПА: create.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create: if isMe(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'username',
          'photoURL',
          'bio',
          'createdAt',
          'updatedAt',
          'usernameChangedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 24
        && request.resource.data.photoURL is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160;

      // Монеты, Premium и рефералы изменяет сервер
      // ПРАВИЛО ДОСТУПА: update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow update: if isMe(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'username',
          'photoURL',
          'bio',
          'createdAt',
          'updatedAt',
          'usernameChangedAt',
          'bannerURL',
          'referralCode',
          'vibecoinBalance',
          'premiumUntil',
          'referredBy',
          'referredAt'
        ])
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'displayName',
            'username',
            'photoURL',
            'bio',
            'updatedAt',
            'usernameChangedAt',
            'bannerURL'
          ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 24
        && request.resource.data.photoURL is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 160
        // Banner uploads require an active, server-issued Premium subscription.
        // Removing an old banner remains allowed even after Premium expires.
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['bannerURL'])
          || !request.resource.data.keys().hasAny(['bannerURL'])
          || (
            request.resource.data.bannerURL is string
            && request.resource.data.bannerURL.size() <= 2000
            && resource.data.keys().hasAny(['premiumUntil'])
            && resource.data.premiumUntil is int
            && resource.data.premiumUntil > request.time.toMillis()
          )
        );

      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if false;

      // ==============================
      // PREMIUM СТИКЕРЫ
      // ==============================

      match /stickers/{stickerId} {
        // ПРАВИЛО ДОСТУПА: read.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow read: if signedIn();

        // ПРАВИЛО ДОСТУПА: create.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow create: if isMe(userId)
          && get(
            /databases/$(database)/documents/users/$(userId)
          ).data.premiumUntil > request.time.toMillis()
          && request.resource.data.keys().hasOnly([
            'url',
            'name',
            'createdAt'
          ])
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 2000
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.createdAt is int;

        // ПРАВИЛО ДОСТУПА: update.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow update: if false;
        // ПРАВИЛО ДОСТУПА: delete.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow delete: if isMe(userId);
      }

      // ==============================
      // ЗАЯВКИ В ДРУЗЬЯ
      // ==============================

      match /friendRequests/{fromUid} {
        // ПРАВИЛО ДОСТУПА: read, delete.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow read, delete: if isMe(userId);

        // ПРАВИЛО ДОСТУПА: create.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow create: if signedIn()
          && request.auth.uid == fromUid
          && fromUid != userId
          && request.resource.data.fromUid == fromUid
          && request.resource.data.toUid == userId
          && request.resource.data.status == 'pending'
          && request.resource.data.displayName is string
          && request.resource.data.username is string
          && request.resource.data.photoURL is string;

        // ПРАВИЛО ДОСТУПА: update.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow update: if false;
      }

      // ==============================
      // ДРУЗЬЯ
      // ==============================

      match /friends/{friendUid} {
        // ПРАВИЛО ДОСТУПА: read.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || request.auth.uid == friendUid
          );

        // Both sides of an accepted friendship must have a real pending request.
        // Prevent arbitrary users from creating forged friend relationships.
        // ПРАВИЛО ДОСТУПА: create.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow create: if signedIn()
          && userId != friendUid
          && (
            (
              request.auth.uid == userId
              && exists(
                /databases/$(database)/documents/users/$(userId)/friendRequests/$(friendUid)
              )
            )
            || (
              request.auth.uid == friendUid
              && exists(
                /databases/$(database)/documents/users/$(friendUid)/friendRequests/$(userId)
              )
            )
          )
          && request.resource.data.uid == friendUid;

        // ПРАВИЛО ДОСТУПА: update.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow update: if signedIn()
          && (
            request.auth.uid == userId
            || request.auth.uid == friendUid
          )
          && request.resource.data.uid == friendUid;

        // ПРАВИЛО ДОСТУПА: delete.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow delete: if isMe(userId);
      }

      // ==============================
      // ОТВЕТЫ НА ИСТОРИИ
      // ==============================

      match /storyReplies/{replyId} {
        // ПРАВИЛО ДОСТУПА: read.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow read: if isMe(userId);

        // ПРАВИЛО ДОСТУПА: create.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow create: if signedIn()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromName is string
          && request.resource.data.storyId is string
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt is int;

        // ПРАВИЛО ДОСТУПА: update, delete.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow update, delete: if isMe(userId);
      }

      // ==============================
      // ОТМЕТКИ В ИСТОРИЯХ
      // ==============================

      match /storyMentions/{storyId} {

        // Отметку видит только получатель
        // ПРАВИЛО ДОСТУПА: read.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow read: if isMe(userId);

        // Создаёт только автор истории,
        // который действительно отметил получателя
        // ПРАВИЛО ДОСТУПА: create.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow create: if signedIn()
          && userId != request.auth.uid
          && request.resource.data.keys().hasOnly([
            'storyId',
            'fromUid',
            'fromUsername',
            'recipientUid',
            'createdAt',
            'expiresAt'
          ])
          && request.resource.data.storyId == storyId
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.recipientUid == userId
          && request.resource.data.fromUsername is string
          && request.resource.data.fromUsername.size() <= 24
          && request.resource.data.createdAt is int
          && request.resource.data.expiresAt is int
          && exists(storyPath(storyId))
          && get(storyPath(storyId)).data.uid
            == request.auth.uid
          && get(storyPath(storyId)).data.expiresAt
            > request.time.toMillis()
          && get(storyPath(storyId)).data.mentionedUids
            is list
          && get(storyPath(storyId)).data.mentionedUids
            .hasAny([userId])
          && request.resource.data.expiresAt
            == get(storyPath(storyId)).data.expiresAt;

        // ПРАВИЛО ДОСТУПА: update.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow update: if false;
        // ПРАВИЛО ДОСТУПА: delete.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow delete: if isMe(userId);
      }
    }

    // ==============================
    // УНИКАЛЬНЫЕ НИКНЕЙМЫ
    // ==============================

    match /usernames/{username} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if signedIn();

      // ПРАВИЛО ДОСТУПА: create.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create: if signedIn()
        && !exists(
          /databases/$(database)/documents/usernames/$(username)
        )
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;

      // ПРАВИЛО ДОСТУПА: update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;

      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ==============================
    // PEER SESSIONS
    // ==============================

    match /peerSessions/{peerId} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if signedIn();

      // ПРАВИЛО ДОСТУПА: create, update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create, update: if signedIn()
        && request.resource.data.peerId == peerId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'peerId',
          'ownerUid',
          'updatedAt'
        ]);

      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ==============================
    // ГОЛОСОВАЯ РУЛЕТКА
    // ==============================

    match /artifacts/{appId}/public/data/{queueName}/{peerId} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if signedIn()
        && appId == 'voicevibe-1b8c0';

      // ПРАВИЛО ДОСТУПА: create, update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create, update: if signedIn()
        && appId == 'voicevibe-1b8c0'
        && request.resource.data.keys().hasAll([
          'peerId',
          'ownerUid',
          'timestamp'
        ])
        && request.resource.data.keys().hasOnly([
          'peerId',
          'ownerUid',
          'timestamp'
        ])
        && request.resource.data.peerId == peerId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.timestamp is int;

      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if signedIn()
        && appId == 'voicevibe-1b8c0'
        && resource.data.ownerUid == request.auth.uid;
    }

    // ==============================
    // ОНЛАЙН СТАТУС
    // ==============================

    // Public online count uses no emails, usernames or profile content.
    // Only an authenticated account may publish its own heartbeat.
    match /onlinePublic/{userId} {
      // ПРАВИЛО ДОСТУПА: get, list.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow get, list: if signedIn();
      // ПРАВИЛО ДОСТУПА: create, update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create, update: if isMe(userId)
        && request.resource.data.keys().hasOnly(['uid', 'lastSeen'])
        && request.resource.data.uid == userId
        && request.resource.data.lastSeen is int
        && request.resource.data.lastSeen >= 0
        && request.resource.data.lastSeen <= request.time.toMillis() + 60000;
      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if isMe(userId);
    }

    match /presence/{userId} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || exists(
            /databases/$(database)/documents/users/$(request.auth.uid)/friends/$(userId)
          )
        );

      // ПРАВИЛО ДОСТУПА: create, update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create, update: if isMe(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.online is bool
        && request.resource.data.lastSeen is int
        && request.resource.data.keys().hasOnly([
          'uid',
          'online',
          'lastSeen'
        ]);

      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if isMe(userId);
    }

    // ==============================
    // ИСТОРИИ
    // ==============================

    match /stories/{storyId} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if signedIn();

      // ПРАВИЛО ДОСТУПА: create.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid

        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'username',
          'photoURL',
          'text',
          'mediaURL',
          'mediaType',
          'musicURL',
          'musicStart',
          'musicLength',
          'musicFade',
          'storyFilter',
          'textPosition',
          'textLayers',
          'mentions',
          'mentionedUids',
          'repostOf',
          'repostAuthorUid',
          'repostUsername',
          'repostText',
          'likes',
          'views',
          'replies',
          'createdAt',
          'expiresAt'
        ])

        // Данные автора
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.photoURL is string

        // Текст
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500

        // Фото или видео
        && request.resource.data.mediaURL is string
        && request.resource.data.mediaURL.size() <= 4000
        && request.resource.data.mediaType in [
          'text',
          'image',
          'video'
        ]

        // Музыка
        && request.resource.data.musicURL is string
        && request.resource.data.musicURL.size() <= 4000

        // Отметки пользователей
        && (
          !request.resource.data.keys().hasAny(['mentions'])
          || (
            request.resource.data.mentions is list
            && request.resource.data.mentions.size() <= 15
          )
        )

        && (
          !request.resource.data.keys().hasAny(['mentionedUids'])
          || (
            request.resource.data.mentionedUids is list
            && request.resource.data.mentionedUids.size() <= 15
          )
        )

        // Длина музыки: максимум 10 секунд
        && (
          !request.resource.data.keys().hasAny(['musicLength'])
          || (
            request.resource.data.musicLength is number
            && request.resource.data.musicLength >= 0
            && request.resource.data.musicLength <= 10
          )
        )

        && (
          !request.resource.data.keys().hasAny(['musicStart'])
          || (
            request.resource.data.musicStart is number
            && request.resource.data.musicStart >= 0
          )
        )

        && (
          !request.resource.data.keys().hasAny(['musicFade'])
          || request.resource.data.musicFade is bool
        )

        && (
          !request.resource.data.keys().hasAny(['storyFilter'])
          || request.resource.data.storyFilter in [
            'none',
            'warm',
            'cool',
            'mono',
            'vivid',
            'retro'
          ]
        )

        // Позиция текста на экране
        && (
          !request.resource.data.keys().hasAny(['textPosition'])
          || (
            request.resource.data.textPosition is map
            && request.resource.data.textPosition.keys()
              .hasOnly(['x', 'y', 'version', 'size', 'color', 'bold', 'align', 'font', 'background'])
            && request.resource.data.textPosition.x is number
            && request.resource.data.textPosition.y is number
          )
        )

        // Несколько независимых текстовых блоков (до 10)
        && (
          !request.resource.data.keys().hasAny(['textLayers'])
          || (
            request.resource.data.textLayers is list
            && request.resource.data.textLayers.size() <= 10
          )
        )

        // Новая история создаётся без просмотров и лайков
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0
        && request.resource.data.views is list
        && request.resource.data.views.size() == 0
        && request.resource.data.replies is list
        && request.resource.data.replies.size() == 0

        // Срок жизни: максимум 24 часа
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.createdAt
          <= request.time.toMillis() + 60000
        && request.resource.data.createdAt
          >= request.time.toMillis() - 300000
        && request.resource.data.expiresAt
          > request.resource.data.createdAt
        && request.resource.data.expiresAt
          <= request.resource.data.createdAt + 86400000

        // Репост только при наличии отметки
        && validStoryRepost();

      // Лайки, просмотры, ответы
      // ПРАВИЛО ДОСТУПА: update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'likes',
            'views',
            'replies'
          ])
        && request.resource.data.likes is list
        && request.resource.data.likes.size() <= 5000
        && request.resource.data.views is list
        && request.resource.data.views.size() <= 5000
        && request.resource.data.replies is list
        && request.resource.data.replies.size() <= 500;

      // Удалять историю может только автор
      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ==============================
    // ЛИЧНЫЕ ЧАТЫ
    // ==============================

    match /conversations/{chatId} {

      function isFriendConversation(data) {
        let otherUid = data.participants[0] == request.auth.uid
          ? data.participants[1]
          : data.participants[0];

        return exists(
          /databases/$(database)/documents/users/$(request.auth.uid)/friends/$(otherUid)
        )
        || exists(
          /databases/$(database)/documents/users/$(otherUid)/friends/$(request.auth.uid)
        );
      }

      // ПРАВИЛО ДОСТУПА: get.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow get: if signedIn()
        && (
          !exists(
            /databases/$(database)/documents/conversations/$(chatId)
          )
          || (
            resource.data.participants is list
            && resource.data.participants.hasAny([
              request.auth.uid
            ])
          )
        );

      // A matching array-contains(uid) query proves this membership condition.
      // ПРАВИЛО ДОСТУПА: list.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow list: if signedIn()
        && request.auth.uid in resource.data.participants;

      // ПРАВИЛО ДОСТУПА: create.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && isFriendConversation(request.resource.data);

      // ПРАВИЛО ДОСТУПА: update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow update: if signedIn()
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants
          == resource.data.participants
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'updatedAt',
            'lastMessage',
            'wallpaperURL'
          ])
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is int
        )
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['lastMessage'])
          || (
            request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 100
          )
        )
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['wallpaperURL'])
          || request.resource.data.wallpaperURL is string
        );

      // Дополнительные ограниченные изменения: закрепление и отметка прочтения.
      allow update: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessage'])
            && request.resource.data.keys().hasAny(['pinnedMessage']) && validPin())
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
            && validSelfReceipt())
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt'])
            && validSelfDelivery())
        );

      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if false;

      // ==============================
      // СООБЩЕНИЯ В ЧАТАХ
      // ==============================

      match /messages/{messageId} {

        function participant() {
          return signedIn()
            && get(
              /databases/$(database)/documents/conversations/$(chatId)
            ).data.participants.hasAny([
              request.auth.uid
            ]);
        }
        function blockedConversation() {
          let members=get(/databases/$(database)/documents/conversations/$(chatId)).data.participants;
          let other=members[0] == request.auth.uid ? members[1] : members[0];
          return exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(other))
            || exists(/databases/$(database)/documents/users/$(other)/blocked/$(request.auth.uid));
        }


        // ПРАВИЛО ДОСТУПА: read.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow read: if participant();

        // ПРАВИЛО ДОСТУПА: create.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow create: if participant() && !blockedConversation()
          && (!request.resource.data.keys().hasAny(['reactions']) || request.resource.data.reactions == {})
          && request.resource.data.senderUid
            == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.type in [
            'text',
            'snake-challenge',
            'snake-result',
            'sticker',
            'voice'
          ]
          && (request.resource.data.type != 'voice' || validVoiceNote())
          && validReplyFields()
          && validForwardFields()
          && (!request.resource.data.keys().hasAny(['forwardedFrom']) || request.resource.data.type in ['text','sticker'])
          && (
            request.resource.data.type != 'sticker'
            || get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.premiumUntil > request.time.toMillis()
          );

        // ПРАВИЛО ДОСТУПА: update.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow update: if participant() && (validReactionUpdate() || validEdit());
        // ПРАВИЛО ДОСТУПА: delete.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        // Автор может удалить только своё сообщение; остальные участники — нет.
        allow delete: if participant()
          && resource.data.senderUid == request.auth.uid;
      }
    }

    // ==============================
    // ГРУППЫ
    // ==============================

    match /groups/{groupId} {
      // Чтение доступно только участникам, включая участников старых групп.
      // Запрос клиента: where('members', 'array-contains', request.auth.uid).
      function isGroupMember() {
        return signedIn()
          && request.auth.uid in resource.data.members;
      }

      // ПРАВИЛО ДОСТУПА: get, list.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow get, list: if isGroupMember();

      // Создание групп через сервер
      // ПРАВИЛО ДОСТУПА: create.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create: if false;

      // ПРАВИЛО ДОСТУПА: update.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow update: if signedIn()
        && resource.data.members is list
        && resource.data.members.hasAny([
          request.auth.uid
        ])
        && request.resource.data.members
          == resource.data.members
        && request.resource.data.createdBy
          == resource.data.createdBy
        && request.resource.data.name
          == resource.data.name
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly([
            'updatedAt',
            'lastMessage',
            'wallpaperURL'
          ])
        && request.resource.data.updatedAt is int
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['lastMessage'])
          || (
            request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 100
          )
        )
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['wallpaperURL'])
          || request.resource.data.wallpaperURL is string
        );

      // Участник может закреплять сообщение, но не менять состав группы.
      allow update: if signedIn() && resource.data.members is list
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.name == resource.data.name
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinnedMessage'])
        && request.resource.data.keys().hasAny(['pinnedMessage'])
        && validPin();

      // ПРАВИЛО ДОСТУПА: delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;

      // ==============================
      // СООБЩЕНИЯ ГРУПП
      // ==============================

      match /messages/{messageId} {

        function groupMember() {
          return signedIn()
            && get(
              /databases/$(database)/documents/groups/$(groupId)
            ).data.members.hasAny([
              request.auth.uid
            ]);
        }

        // ПРАВИЛО ДОСТУПА: read.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow read: if groupMember();

        // ПРАВИЛО ДОСТУПА: create.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow create: if groupMember()
          && (!request.resource.data.keys().hasAny(['reactions']) || request.resource.data.reactions == {})
          && request.resource.data.senderUid
            == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.type in [
            'text',
            'sticker',
            'voice'
          ]
          && request.resource.data.createdAt is int
          && (request.resource.data.type != 'voice' || validVoiceNote())
          && validReplyFields()
          && validForwardFields()
          && (!request.resource.data.keys().hasAny(['forwardedFrom']) || request.resource.data.type in ['text','sticker'])
          && (
            request.resource.data.type != 'sticker'
            || get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.premiumUntil > request.time.toMillis()
          );

        // ПРАВИЛО ДОСТУПА: update.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        allow update: if groupMember() && (validReactionUpdate() || validEdit());
        // ПРАВИЛО ДОСТУПА: delete.
        // Проверка выполняется сервером Firestore для каждого запроса.
        // Условия ниже определяют, кому разрешена эта операция.
        // Отказ в доступе не обходится изменением интерфейса сайта.
        // Автор может удалить своё сообщение даже в группе.
        allow delete: if groupMember()
          && resource.data.senderUid == request.auth.uid;
      }
    }

    // ==============================
    // РЕФЕРАЛЬНЫЕ КОДЫ
    // ==============================

    match /referralCodes/{code} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if signedIn();

      // Только сервер
      // ПРАВИЛО ДОСТУПА: create, update, delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create, update, delete: if false;
    }

    // ==============================
    // РЕФЕРАЛЬНЫЕ НАЧИСЛЕНИЯ
    // ==============================

    match /referralClaims/{uid} {
      // ПРАВИЛО ДОСТУПА: read.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read: if isMe(uid);

      // Только сервер
      // ПРАВИЛО ДОСТУПА: create, update, delete.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow create, update, delete: if false;
    }

    // Дополнительные безопасные подколлекции пользовательских настроек.
    match /users/{ownerUid}/blocked/{targetUid} {
      allow get, list: if isMe(ownerUid);
      allow create, update: if isMe(ownerUid)
        && ownerUid != targetUid
        && request.resource.data.keys().hasOnly(['targetUid','createdAt'])
        && request.resource.data.targetUid == targetUid
        && request.resource.data.createdAt is int;
      allow delete: if isMe(ownerUid);
    }
    match /users/{ownerUid}/settings/{settingId} {
      allow get: if isMe(ownerUid);
      allow list: if false;
      allow create, update: if isMe(ownerUid) && settingId == 'privacy'
        && request.resource.data.keys().hasOnly(['readReceipts'])
        && request.resource.data.readReceipts is bool;
      allow delete: if false;
    }
    match /conversations/{chatId}/typing/{userId} {
      function typeMember() {
        return signedIn() && get(/databases/$(database)/documents/conversations/$(chatId)).data.participants.hasAny([request.auth.uid]);
      }
      allow get: if typeMember();
      allow list: if false;
      allow create, update: if typeMember() && isMe(userId)
        && request.resource.data.keys().hasOnly(['active','updatedAt'])
        && request.resource.data.active is bool
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt <= request.time.toMillis()+60000;
      allow delete: if typeMember() && isMe(userId);
    }
    match /reports/{reportId} {
      allow get, list: if isModerator();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterUid','targetUid','reason','createdAt','scope','chatId','messageId'])
        && request.resource.data.keys().hasAll(['reporterUid','targetUid','reason','createdAt','scope','chatId','messageId'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() <= 128
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in ['spam','harassment','inappropriate','other']
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt <= request.time.toMillis()+60000
        && request.resource.data.scope in ['conversations','groups']
        && request.resource.data.chatId is string
        && request.resource.data.chatId.size() <= 200
        && request.resource.data.messageId is string
        && request.resource.data.messageId.size() <= 200;
      allow update, delete: if false;
    }

    // ==============================
    // ОБРАЩЕНИЯ В ПОДДЕРЖКУ: ПОЛЬЗОВАТЕЛЬ + МОДЕРАТОРЫ
    // ==============================
    match /supportThreads/{userId} {
      allow get: if isMe(userId) || isModerator();
      // Users must not list other people's support conversations.
      allow list: if isModerator();
      allow create: if (isMe(userId) || isModerator())
        && request.resource.data.keys().hasOnly(['userUid','createdAt','updatedAt','lastMessage'])
        && request.resource.data.keys().hasAll(['userUid','createdAt','updatedAt','lastMessage'])
        && request.resource.data.userUid == userId
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= request.resource.data.createdAt
        && request.resource.data.createdAt <= request.time.toMillis() + 60000
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 140;
      allow update: if (isMe(userId) || isModerator())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessage'])
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.updatedAt <= request.time.toMillis() + 60000
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 140;
      allow delete: if false;
      match /messages/{messageId} {
        allow get, list: if isMe(userId) || isModerator();
        allow create: if (isMe(userId) || isModerator())
          && exists(/databases/$(database)/documents/supportThreads/$(userId))
          && request.resource.data.keys().hasOnly(['senderUid','text','createdAt'])
          && request.resource.data.keys().hasAll(['senderUid','text','createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is int
          && request.resource.data.createdAt <= request.time.toMillis() + 60000;
        allow update, delete: if false;
      }
    }

    // ==============================
    // ВСЁ ОСТАЛЬНОЕ ЗАКРЫТО
    // ==============================

    match /{document=**} {
      // ПРАВИЛО ДОСТУПА: read, write.
      // Проверка выполняется сервером Firestore для каждого запроса.
      // Условия ниже определяют, кому разрешена эта операция.
      // Отказ в доступе не обходится изменением интерфейса сайта.
      allow read, write: if false;
    }
  }
}
